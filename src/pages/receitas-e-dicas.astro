---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import { DICAS } from '../data/conteudo';
import { CONFIG, instagramUrl, nomeFormal } from '../config';
import '../styles/interna.css';
---
<Base titulo="Conteúdos" descricao="Conteúdos educativos sobre alimentação, composição corporal, intestino e rotina, escritos pela nutricionista Dra. Sueli Ribeiro.">
  <section class="int-hero">
    <div class="wrap">
      <nav class="migalha" aria-label="Você está em" data-anim="sobe"><a href="/">Início</a><span aria-hidden="true">/</span><span>Conteúdos</span></nav>
      <h1 data-titulo>Conteúdos informativos.</h1>
      <p class="sub" data-anim="sobe">Textos sobre temas frequentes na prática clínica, com base em evidências científicas. Conteúdos e receitas novos são publicados no Instagram.</p>
    </div>
  </section>
  <section class="sec sec--bege">
    <div class="wrap">
      <ul class="lista-conteudos" data-anim="stagger">
        {DICAS.map((d) => (
          <li class="conteudo">
            <div class="foto"><Foto foto={d.foto} ratio={3 / 2} sizes="(max-width: 860px) 92vw, 40vw" larguras={[480, 720, 960]} /></div>
            <div>
              <h2>{d.titulo}</h2>
              <p class="texto-2">{d.texto}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="aviso">Conteúdo informativo. Não substitui consulta nem orientação médica.</p>
    </div>
  </section>
  <section class="sec">
    <div class="wrap cta-faixa">
      <h2 data-titulo>Mais conteúdos no Instagram.</h2>
      <a class="btn" data-magnetico href={instagramUrl} target="_blank" rel="noopener"><Icone nome="instagram" /> @{CONFIG.instagram}</a>
    </div>
  </section>
</Base>
<style>
  .lista-conteudos { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(3rem, 6vw, 5rem); }
  .conteudo { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .conteudo:nth-child(even) .foto { order: 2; }
  .conteudo .foto { aspect-ratio: 3 / 2; }
  .conteudo h2 { font-size: var(--fs-4); margin-bottom: 1.2rem; }
  .conteudo p { max-width: 48ch; font-size: var(--fs-2); line-height: 1.55; }
  @media (max-width: 860px) { .conteudo { grid-template-columns: 1fr; } .conteudo:nth-child(even) .foto { order: 0; } }
</style>
