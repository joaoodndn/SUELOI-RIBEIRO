---
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Icone from '../../components/Icone.astro';
import { AREAS, type Area } from '../../data/areas';
import { linkAgendamento } from '../../config';
import '../../styles/interna.css';

export function getStaticPaths() {
  return AREAS.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}
const { area } = Astro.props as { area: Area };
const outras = AREAS.filter((a) => a.slug !== area.slug);
const msg = `Olá, Sueli! Vim pelo site e gostaria de agendar uma consulta sobre ${area.titulo.toLowerCase()}.`;
---
<Base titulo={area.titulo} descricao={area.resumo}>
  <section class="int-hero">
    <div class="wrap int-hero__grid">
      <div>
        <nav class="migalha" aria-label="Você está em" data-anim="sobe">
          <a href="/">Início</a><span aria-hidden="true">/</span><a href="/#areas">Áreas de atuação</a>
        </nav>
        <h1 data-titulo>{area.titulo}</h1>
        <p class="sub" data-anim="sobe">{area.resumo}</p>
        <div style="margin-top:2.2rem" data-anim="sobe">
          <a class="btn" data-magnetico href={linkAgendamento(msg)} target="_blank" rel="noopener">Agendar consulta <Icone nome="seta" /></a>
        </div>
      </div>
      <div class="foto foto--arco int-hero__foto" data-anim="mascara">
        <Foto foto={area.foto} ratio={4 / 5} sizes="(max-width: 860px) 92vw, 40vw" prioridade />
      </div>
    </div>
  </section>

  <section class="sec sec--bege">
    <div class="wrap">
      <div class="blocos">
        <div class="bloco" data-anim="sobe">
          <h2>O que é</h2>
          <div class="prosa">{area.oQueE.map((p) => <p>{p}</p>)}</div>
        </div>
        <div class="bloco" data-anim="sobe">
          <h2>Para quem é</h2>
          <ul class="lista-fina">{area.paraQuem.map((p) => <li>{p}</li>)}</ul>
        </div>
        <div class="bloco" data-anim="sobe">
          <h2>Como é o acompanhamento</h2>
          <ul class="lista-fina">{area.acompanhamento.map((p) => <li>{p}</li>)}</ul>
        </div>
        <div class="bloco" data-anim="sobe">
          <h2>O que esperar na consulta</h2>
          <ul class="lista-fina">{area.naConsulta.map((p) => <li>{p}</li>)}</ul>
        </div>
      </div>
      {area.observacao && (
        <p class="aviso" data-anim="sobe"><strong>Importante:</strong> {area.observacao}</p>
      )}
      <p class="aviso" data-anim="sobe">Conteúdo informativo. Não substitui consulta nem orientação médica.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="cta-faixa" style="margin-bottom:clamp(3rem,6vw,5rem)">
        <h2 data-titulo>Quer começar por aqui?</h2>
        <a class="btn" data-magnetico href={linkAgendamento(msg)} target="_blank" rel="noopener">Agendar consulta <Icone nome="seta" /></a>
      </div>
      <span class="rotulo">Outras áreas</span>
      <ul class="outras" data-anim="stagger">
        {outras.map((o) => <li><a href={`/areas/${o.slug}`}>{o.titulo}<Icone nome="seta" /></a></li>)}
      </ul>
    </div>
  </section>
</Base>
