---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import { Image } from 'astro:assets';
import { AREAS } from '../data/areas';
import { FOTOS, FAIXA } from '../data/fotos';
import { FAQ, DICAS, AVALIACOES } from '../data/conteudo';
import Calculadoras from '../components/Calculadoras.astro';
import { CONFIG, linkAgendamento, canalAgendamento, instagramUrl, preenchido, localTexto, nomeFormal } from '../config';
import retratoHero from '../assets/img/sueli-rosto-2-perfil-sorrindo-mesa.jpg';
import fotoSobre from '../assets/img/sueli-sobre-barcelona.jpg';

const confianca = [
  CONFIG.crn,
  'Atendimento individualizado',
  'Avaliação de composição corporal',
  'Plano a partir dos seus exames',
  'Sem dietas extremas',
  ...(CONFIG.atendimentoPresencial && CONFIG.atendimentoOnline ? ['Presencial e online'] : []),
];

const etapas = [
  {
    n: '01',
    titulo: 'Avaliação',
    texto: 'Conversa sobre histórico, rotina, sono, treino e alimentação. Medidas, composição corporal quando aplicável e leitura dos seus exames.',
    foto: FOTOS.avaliacao,
  },
  {
    n: '02',
    titulo: 'Planejamento',
    texto: 'Plano alimentar individualizado, com opções e substituições para casa, trabalho e refeições fora. Nada de cardápio genérico.',
    foto: FOTOS.planejamento,
  },
  {
    n: '03',
    titulo: 'Acompanhamento',
    texto: 'Retornos para reavaliar medidas, sintomas e exames, entender o que funcionou e ajustar o plano. A evolução é acompanhada além do peso.',
    foto: FOTOS.acompanhamento,
  },
];
---
<Base
  titulo={`${nomeFormal} | Nutricionista clínica em ${CONFIG.cidade}, ${CONFIG.uf}`}
  descricao={`Nutricionista clínica em ${CONFIG.cidade}, ${CONFIG.estado} (${CONFIG.crn}). Emagrecimento e composição corporal, acompanhamento com GLP-1, hipertrofia, saúde metabólica, intestinal e intolerâncias alimentares.`}
  intro
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__texto">
        <p class="hero__selo" data-hero="sobe">
          <span><strong>{nomeFormal}</strong><br />Nutricionista · {CONFIG.crn}</span>
        </p>
        <h1 class="hero__titulo" data-titulo="hero">Ciência e estratégia para uma nutrição individualizada</h1>
        <p class="hero__sub" data-hero="sobe">
          Nutricionista clínica com atuação em Cacoal, Rondônia, especializada no acompanhamento nutricional voltado ao emagrecimento, à otimização da composição corporal, à hipertrofia muscular e à promoção da saúde metabólica e intestinal. O atendimento é fundamentado em uma abordagem individualizada, baseada na avaliação clínica, na interpretação de exames laboratoriais e nas necessidades fisiológicas e nutricionais de cada paciente, considerando também seus hábitos, sua rotina e suas preferências alimentares.
        </p>
        <div class="hero__acoes" data-hero="sobe">
          <a class="btn" data-magnetico href={linkAgendamento()} target="_blank" rel="noopener">
            Agendar consulta <Icone nome="seta" />
          </a>
          <a class="btn btn--linha" href="#areas">Conhecer as áreas</a>
        </div>
      </div>
      <div class="hero__fotos">
        <div class="foto foto--arco hero__foto-a" data-hero="foto" data-mouse="18">
          <Image src={retratoHero} alt={`${nomeFormal} sorrindo, sentada à mesa do consultório`} widths={[480, 720, 959]} sizes="(max-width: 900px) 92vw, 40vw" loading="eager" fetchpriority="high" class="hero__retrato" />
        </div>
      </div>
    </div>
  </section>

  <!-- FAIXA DE CONFIANÇA -->
  <div class="marquee" aria-label="Diferenciais do atendimento">
    <div class="marquee__trilho">
      {[0, 1].map((k) => (
        <ul aria-hidden={k === 1 ? 'true' : undefined}>
          {confianca.map((c) => <li>{c}</li>)}
        </ul>
      ))}
    </div>
  </div>

  <!-- APRESENTAÇÃO -->
  <section class="sec apresenta">
    <div class="wrap apresenta__grid">
      <span class="rotulo" data-traco>A proposta</span>
      <div class="apresenta__texto" data-acende>
        <p>A nutrição clínica vai muito além da alimentação. Envolve uma avaliação abrangente dos exames laboratoriais, da qualidade do sono, da prática de atividades físicas, dos sintomas apresentados e dos hábitos que compõem a rotina de cada indivíduo.</p>
        <p>Com base nessa análise, é desenvolvido um planejamento nutricional individualizado, com ajustes estratégicos que atendam às necessidades específicas de cada paciente, respeitando suas preferências alimentares e sua realidade cotidiana.</p>
      </div>
    </div>
  </section>

  <!-- ÁREAS -->
  <section class="sec sec--bege" id="areas">
    <div class="wrap">
      <div class="cabeca">
        <div>
          <span class="rotulo" data-traco>Áreas de atuação</span>
          <h2 class="titulo" data-titulo>Seis frentes, um acompanhamento.</h2>
        </div>
        <p class="sub" data-anim="sobe">Cada área tem uma página com o que é, para quem é indicada e como funciona o acompanhamento.</p>
      </div>
      <ul class="areas" data-anim="cartoes">
        {AREAS.map((a) => (
          <li>
            <a class="area" href={`/areas/${a.slug}`} data-tilt data-cursor="Ver área">
              <div class="foto area__foto">
                <Foto foto={a.foto} ratio={4 / 3} sizes="(max-width: 640px) 92vw, (max-width: 1000px) 45vw, 30vw" larguras={[400, 600, 800]} />
              </div>
              <h3 class="area__titulo">{a.titulo}</h3>
              <p class="area__resumo">{a.resumo}</p>
              <span class="area__mais">Saiba mais <Icone nome="seta" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SOBRE -->
  <section class="sec sobre" id="sobre">
    <div class="wrap sobre__grid">
      <div class="sobre__foto-col">
        <div class="foto foto--arco sobre__foto" data-anim="mascara">
          <Image src={fotoSobre} alt={`${nomeFormal} sentada em uma escadaria ao ar livre, com palmeiras ao fundo`} widths={[450, 700, 900]} sizes="(max-width: 900px) 80vw, 400px" class="sobre__retrato" />
        </div>
      </div>
      <div class="sobre__texto">
        <span class="rotulo" data-traco>Sobre</span>
        <h2 class="titulo" data-titulo>Quem é a {nomeFormal}</h2>
        <p class="sobre__crn" data-anim="sobe">Nutricionista · {CONFIG.crn}</p>
        <div class="prosa" data-anim="sobe">
          <p>Atendo em {localTexto()} com foco em nutrição clínica: emagrecimento e composição corporal, acompanhamento de quem usa medicamentos da classe GLP-1, hipertrofia, saúde metabólica, intestinal e intolerâncias alimentares.</p>
          <p>O plano é sempre individual. Ele leva em conta exames, rotina, preferências e o momento de cada pessoa, e é ajustado a cada retorno.</p>
        </div>
        <a class="link sobre__link" href="/sobre" data-anim="sobe">Mais sobre a Dra. Sueli</a>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section class="sec sec--bege" id="como-funciona">
    <div class="wrap">
      <div class="cabeca">
        <div>
          <span class="rotulo" data-traco>Como funciona</span>
          <h2 class="titulo" data-titulo>Três etapas, do primeiro encontro aos retornos.</h2>
        </div>
      </div>
      <div class="etapas__palco">
      <ol class="etapas__indice" aria-hidden="true">
        {etapas.map((e) => <li><span>{e.n}</span>{e.titulo}</li>)}
      </ol>
      <ol class="etapas" data-linha>
        <span class="etapas__linha" aria-hidden="true"><span class="etapas__linha-fill"></span></span>
        {etapas.map((e) => (
          <li class="etapa">
            <span class="etapa__n" aria-hidden="true">{e.n}</span>
            <div class="etapa__corpo">
              <h3 class="etapa__titulo">{e.titulo}</h3>
              <p class="texto-2">{e.texto}</p>
            </div>
            <div class="foto etapa__foto" data-anim="mascara">
              <Foto foto={e.foto} ratio={3 / 2} sizes="(max-width: 900px) 92vw, 30vw" larguras={[400, 600, 900]} />
            </div>
          </li>
        ))}
      </ol>
      </div>
    </div>
  </section>

  <!-- ALÉM DO PRATO (scroll horizontal) -->
  <section class="faixa sec--escura" data-horizontal data-cursor-escuro aria-labelledby="faixa-titulo">
    <div class="faixa__trilho">
      <div class="faixa__intro">
        <span class="rotulo" data-traco>O que entra na conta</span>
        <h2 class="titulo" id="faixa-titulo" data-titulo>Nutrição vai além do prato.</h2>
        <p class="sub">Sono, treino, hidratação, exames, intestino, rotina de compras. Tudo isso pesa no resultado e entra na conversa.</p>
        <p class="faixa__dica"><span class="faixa__dica-txt-rolar">Role para ver mais</span><span class="faixa__dica-txt-arrastar">Arraste para o lado</span><span class="faixa__seta" aria-hidden="true"><Icone nome="seta" /></span></p>
      </div>
      {FAIXA.map((f, i) => (
        <figure class={`faixa__item ${f.r > 1 ? 'faixa__item--larga' : ''}`} data-par={i % 2 === 0 ? 'par' : 'impar'}>
          <div class="foto faixa__foto">
            <Foto foto={f} ratio={f.r > 1 ? 4 / 3 : 3 / 4} sizes={f.r > 1 ? '(max-width: 900px) 85vw, 34vw' : '(max-width: 900px) 68vw, 24vw'} larguras={[360, 540, 720, 960]} />
          </div>
          <figcaption>{f.legenda}</figcaption>
        </figure>
      ))}
    </div>
    <div class="faixa__nav">
      <button type="button" class="faixa__btn" data-dir="-1" aria-label="Ver fotos anteriores"><Icone nome="seta" /></button>
      <button type="button" class="faixa__btn" data-dir="1" aria-label="Ver próximas fotos"><Icone nome="seta" /></button>
    </div>
    <div class="faixa__barra" aria-hidden="true"><span></span></div>
  </section>

  <!-- CONTEÚDOS -->
  <section class="sec" id="conteudos">
    <div class="wrap">
      <div class="cabeca">
        <div>
          <span class="rotulo" data-traco>Conteúdos</span>
          <h2 class="titulo" data-titulo>Para ler antes da consulta.</h2>
        </div>
        <a class="link" href="/receitas-e-dicas" data-anim="sobe">Ver todos os conteúdos</a>
      </div>
      <ul class="dicas" data-anim="cartoes">
        {DICAS.map((d) => (
          <li class="dica">
            <div class="foto dica__foto"><Foto foto={d.foto} ratio={3 / 2} sizes="(max-width: 760px) 92vw, 30vw" larguras={[400, 600, 800]} /></div>
            <h3 class="dica__titulo">{d.titulo}</h3>
            <p class="texto-2">{d.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- DEPOIMENTOS
       Só publicar depoimentos reais, com autorização por escrito do paciente.
       Para ativar: preencher a lista abaixo e remover o comentário do bloco.

  <section class="sec sec--bege" id="depoimentos">
    <div class="wrap">
      <span class="rotulo" data-traco>Depoimentos</span>
      <h2 class="titulo" data-titulo>Quem já acompanhou.</h2>
      <ul class="depoimentos" data-anim="stagger">
        <li><blockquote>"Texto do depoimento autorizado."</blockquote><p>Nome ou iniciais</p></li>
      </ul>
    </div>
  </section>
  -->

  <!-- AVALIAÇÕES (comentários reais do Instagram) -->
  <section class="sec avaliacoes" id="avaliacoes">
    <div class="wrap">
      <div class="cabeca">
        <div>
          <span class="rotulo" data-traco>Quem já passou por aqui</span>
          <h2 class="titulo" data-titulo>O que dizem sobre o atendimento.</h2>
        </div>
        <p class="sub" data-anim="sobe">Comentários deixados no Instagram da Dra. Sueli.</p>
      </div>
      <ul class="avaliacoes__lista" data-anim="stagger">
        {AVALIACOES.map((a, i) => (
          <li class={`avaliacao ${i >= 3 ? 'avaliacao--extra' : ''}`} hidden={i >= 3}>
            <blockquote>{a.texto}</blockquote>
            <a class="avaliacao__autor" href={a.post} target="_blank" rel="noopener"><Icone nome="instagram" /> {a.autor}</a>
          </li>
        ))}
      </ul>
      <div class="avaliacoes__mais">
        <button type="button" class="btn btn--linha" data-ver-mais aria-expanded="false">Ver mais comentários</button>
        <a class="link" href={instagramUrl} target="_blank" rel="noopener">Ver no Instagram</a>
      </div>
    </div>
  </section>

  <Calculadoras />

  <!-- FAQ -->
  <section class="sec sec--bege" id="faq">
    <div class="wrap faq">
      <div class="faq__cabeca">
        <span class="rotulo" data-traco>Dúvidas frequentes</span>
        <h2 class="titulo" data-titulo>Antes de agendar.</h2>
        <p class="sub" data-anim="sobe">Não achou sua pergunta? Mande uma mensagem pelo {canalAgendamento}.</p>
      </div>
      <div class="faq__lista">
        {FAQ.map((q) => (
          <details class="faq__item">
            <summary><span>{q.p}</span><Icone nome="mais" class="faq__icone" /></summary>
            <div class="faq__resp"><p>{q.r}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTATO -->
  <div class="letreiro">
    <div class="wrap letreiro__in">
      <p class="letreiro__topo" data-anim="sobe">Nutrição clínica · Composição corporal · Saúde metabólica</p>
      <p class="letreiro__frase" data-acende>Ciência e estratégia para uma nutrição individualizada</p>
    </div>
  </div>

  <section class="sec sec--escura contato" id="contato" data-cursor-escuro>
    <div class="wrap contato__grid">
      <div>
        <span class="rotulo" data-traco>Agendamento</span>
        <h2 class="contato__titulo" data-titulo>Vamos marcar sua primeira consulta?</h2>
        <div class="contato__acoes" data-anim="sobe">
          <a class="btn btn--claro" data-magnetico href={linkAgendamento()} target="_blank" rel="noopener">
            <Icone nome={canalAgendamento === 'WhatsApp' ? 'whatsapp' : 'instagram'} /> Agendar pelo {canalAgendamento}
          </a>
          <a class="btn btn--linha" href={instagramUrl} target="_blank" rel="noopener">@{CONFIG.instagram}</a>
        </div>
      </div>
      <ul class="contato__dados" data-anim="stagger">
        <li><Icone nome="local" /><span>{preenchido(CONFIG.endereco) ? `${CONFIG.endereco} · ${localTexto()}` : localTexto()}</span></li>
        {preenchido(CONFIG.horarios) && <li><Icone nome="relogio" /><span>{CONFIG.horarios}</span></li>}
        <li><Icone nome="instagram" /><a class="link" href={instagramUrl} target="_blank" rel="noopener">instagram.com/{CONFIG.instagram}</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero {
    padding-top: calc(var(--header-h) + clamp(2rem, 5vw, 4.5rem));
    padding-bottom: clamp(3rem, 6vw, 6rem);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .hero__selo {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--texto-2);
    margin-bottom: clamp(1.5rem, 3vw, 2.4rem);
  }
  .hero__selo strong {
    color: var(--texto);
    font-weight: 600;
  }
  .hero__avatar {
    width: 104px;
    height: 125px;
    border-radius: 999px 999px 14px 14px;
    object-fit: cover;
    object-position: 50% 30%;
    box-shadow: 0 0 0 1px var(--linha), 0 0 0 5px var(--creme), 0 0 0 6px var(--palha), 0 20px 40px -24px rgba(52, 37, 31, 0.5);
  }
  .hero__selo { gap: 1.1rem; padding-left: 1rem; border-left: 2px solid var(--palha); }
  .hero__selo strong { font-family: var(--serif); font-size: 1.25rem; font-weight: 400; }
  .hero__titulo {
    font-size: clamp(2.35rem, 1.45rem + 3.3vw, 4.7rem);
    line-height: 1.04;
    max-width: 15ch;
  }
  .hero__sub {
    margin-top: clamp(1.4rem, 2.6vw, 2rem);
    font-size: clamp(0.98rem, 0.92rem + 0.25vw, 1.1rem);
    color: var(--texto-2);
    max-width: 54ch;
    line-height: 1.7;
  }
  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.8rem, 3vw, 2.6rem);
  }
  .hero__fotos {
    position: relative;
  }
  .hero__foto-a {
    aspect-ratio: 4 / 5;
    width: 82%;
    margin-left: auto;
  }
  .hero__retrato {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }
  .hero__foto-b {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 40%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 8px solid var(--creme);
  }
  :global(.linha-mascara) {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__titulo {
      max-width: 14ch;
    }
    .hero__fotos {
      max-width: 520px;
    }
  }

  /* MARQUEE */
  .marquee {
    background: var(--palha);
    color: var(--texto);
    overflow: hidden;
    padding-block: 1.15rem;
  }
  .marquee__trilho {
    display: flex;
    width: max-content;
    animation: marquee 55s linear infinite;
  }
  .marquee:hover .marquee__trilho,
  .marquee.is-pausado .marquee__trilho {
    animation-play-state: paused;
  }
  .marquee ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .marquee li {
    font-family: var(--serif);
    font-size: var(--fs-2);
    white-space: nowrap;
    padding-inline: 2rem;
    display: flex;
    align-items: center;
    gap: 4rem;
  }
  .marquee li::after {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--marrom);
    margin-left: 2rem;
  }
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }

  /* APRESENTAÇÃO */
  .apresenta__grid {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 2rem;
    align-items: start;
  }
  .apresenta__grid .rotulo { margin-top: 0.5rem; }
  .apresenta__texto {
    font-family: var(--serif);
    font-size: clamp(1.3rem, 1rem + 1.1vw, 2.05rem);
    line-height: 1.38;
    letter-spacing: -0.01em;
    max-width: 40ch;
  }
  .apresenta__texto p + p { margin-top: 1.1em; }
  @media (max-width: 760px) {
    .apresenta__grid { grid-template-columns: 1fr; gap: 0; }
  }

  /* CABEÇALHO DE SEÇÃO */
  .cabeca {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .cabeca .titulo {
    max-width: 16ch;
  }

  /* ÁREAS */
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2.5rem, 4vw, 3.5rem) clamp(1.25rem, 2.5vw, 2.25rem);
  }
  .area {
    display: block;
    text-decoration: none;
    transform-style: preserve-3d;
  }
  .area__foto {
    aspect-ratio: 4 / 3;
    margin-bottom: 1.4rem;
  }
  .area__foto :global(img) {
    transition: transform 1.2s var(--ease), filter 0.8s var(--ease);
    filter: saturate(0.92);
  }
  .area:hover .area__foto :global(img) {
    transform: scale(1.06);
    filter: saturate(1);
  }
  .area__titulo {
    font-size: var(--fs-3);
    line-height: 1.08;
  }
  .area__resumo {
    color: var(--texto-2);
    margin-top: 0.7rem;
    font-size: 0.97rem;
  }
  .area__mais {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    font-weight: 600;
    font-size: 0.9rem;
    border-bottom: 1px solid var(--linha);
    padding-bottom: 0.2rem;
    transition: border-color 0.4s, gap 0.4s var(--ease);
  }
  .area__mais :global(svg) { width: 1rem; height: 1rem; }
  .area:hover .area__mais { border-color: var(--texto); gap: 0.8rem; }
  @media (max-width: 1000px) {
    .areas { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .areas { grid-template-columns: 1fr; }
  }

  /* SOBRE */
  .sobre__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }
  .sobre__foto-col {
    position: relative;
  }
  .sobre__foto {
    aspect-ratio: 3 / 4;
    max-width: 400px;
  }
  .sobre__avatar {
    position: absolute;
    right: clamp(0rem, 4vw, 3rem);
    bottom: 0;
    margin: 0;
    width: clamp(120px, 12vw, 150px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border: 6px solid var(--creme);
    box-shadow: 0 0 0 1px var(--dourado), 0 18px 40px -20px rgba(52, 37, 31, 0.45);
  }
