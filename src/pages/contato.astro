---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import { CONFIG, linkAgendamento, canalAgendamento, instagramUrl, preenchido, localTexto, nomeFormal } from '../config';
import { FOTOS } from '../data/fotos';
import '../styles/interna.css';
const modalidades = [CONFIG.atendimentoPresencial && 'Presencial', CONFIG.atendimentoOnline && 'Online'].filter(Boolean) as string[];
---
<Base titulo="Contato e agendamento" descricao={`Agende sua consulta com ${nomeFormal}, nutricionista em ${localTexto()}.`}>
  <section class="int-hero">
    <div class="wrap int-hero__grid">
      <div>
        <nav class="migalha" aria-label="Você está em" data-anim="sobe"><a href="/">Início</a><span aria-hidden="true">/</span><span>Contato</span></nav>
        <h1 data-titulo>Agende sua consulta.</h1>
        <p class="sub" data-anim="sobe">O agendamento é feito pelo {canalAgendamento}. Na conversa você combina data, horário e modalidade.</p>
        <div class="hero-acoes" style="display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2.2rem" data-anim="sobe">
          <a class="btn" data-magnetico href={linkAgendamento()} target="_blank" rel="noopener"><Icone nome={canalAgendamento === 'WhatsApp' ? 'whatsapp' : 'instagram'} /> Agendar pelo {canalAgendamento}</a>
          <a class="btn btn--linha" href={instagramUrl} target="_blank" rel="noopener">@{CONFIG.instagram}</a>
        </div>
      </div>
      <div class="foto foto--arco int-hero__foto" data-anim="mascara">
        <Foto foto={FOTOS.agua} ratio={1} sizes="(max-width: 860px) 92vw, 40vw" prioridade />
      </div>
    </div>
  </section>

  <section class="sec sec--bege">
    <div class="wrap blocos">
      <div class="bloco" data-anim="sobe">
        <h2>Onde</h2>
        <ul class="lista-fina">
          <li>{preenchido(CONFIG.endereco) ? `${CONFIG.endereco} · ${localTexto()}` : localTexto()}</li>
          {modalidades.length > 0 && <li>Atendimento {modalidades.join(' e ').toLowerCase()}</li>}
          {preenchido(CONFIG.horarios) && <li>{CONFIG.horarios}</li>}
          <li>{CONFIG.crn}</li>
        </ul>
      </div>
      {preenchido(CONFIG.mapaEmbedUrl) && (
        <div class="bloco foto" data-anim="sobe" style="aspect-ratio:4/3">
          <iframe src={CONFIG.mapaEmbedUrl} title="Mapa do consultório" loading="lazy" referrerpolicy="no-referrer-when-downgrade" style="border:0;width:100%;height:100%"></iframe>
        </div>
      )}
    </div>
  </section>
</Base>
