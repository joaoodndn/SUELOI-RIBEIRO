---
import Base from '../layouts/Base.astro';
import '../styles/interna.css';
---
<Base titulo="Página não encontrada" descricao="A página que você procurou não existe.">
  <section class="int-hero" style="min-height:70vh">
    <div class="wrap">
      <h1>Página não encontrada.</h1>
      <p class="sub">O endereço pode ter mudado. Volte para o início e siga pelo menu.</p>
      <a class="btn" style="margin-top:2rem" href="/">Voltar ao início</a>
    </div>
  </section>
</Base>
