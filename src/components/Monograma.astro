---
interface Props { class?: string; titulo?: string }
const { class: cls, titulo } = Astro.props;
---
<svg class={cls} viewBox="0 0 100 100" fill="none" role={titulo ? 'img' : undefined} aria-hidden={titulo ? undefined : 'true'} aria-label={titulo}>
  <circle class="mono-anel" cx="50" cy="50" r="47" stroke="currentColor" stroke-width="1.2" />
  <text class="mono-letras" x="50" y="50" text-anchor="middle" dominant-baseline="central"
    font-family="Playfair Display Variable, Playfair Display, Georgia, serif" font-size="38" font-weight="400" letter-spacing="-1"
    fill="currentColor" stroke="currentColor" stroke-width="0.6">SR</text>
</svg>
